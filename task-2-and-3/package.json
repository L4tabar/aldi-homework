    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "jiti": "^2.6.0",
    "prettier": "^3.7.4",
    "typescript-eslint": "^8.56.0"
  }
}
