{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "@playwright/test"],
    "baseUrl": "./",
    "paths": {
      "@po/*": ["pages/*"],
      "@fixtures/*": ["fixtures/*"],
      "@testData/*": ["tests/testData/*"],
      "@support/*": ["support/*"]
    }
  },
  "include": ["tests/**/*", "pages/**/*", "fixtures/**/*", "tests/testData/**/*", "support/**/*"],
  "exclude": ["node_modules"]
}
